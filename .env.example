# Copy to .env before running `docker compose up`. Never commit the real .env.

# The one X-Service-Token shared by every service of the stack.
SERVICE_TOKEN=change_me_too
# Signs the player JWT (Player Service) and verifies it (Gateway): the same value
# in both, known to nobody else. At least 32 characters, or the Gateway does not start.
JWT_SECRET=change_me_to_a_random_string_of_32_chars_or_more
# Service Discovery (Lab 3). Every service and the Message Broker register their instances here, the broker
# routes from it and Prometheus reads its targets from it; the internal container address, nothing secret.
SERVICE_DISCOVERY_URL=http://service-discovery-service:8090
# Message Broker (Lab 4): the gRPC host:port (no scheme) of the broker, the same for the Gateway and every service;
# the internal container address, nothing secret. Requests and events between the components travel through it.
MESSAGE_BROKER_URL=message-broker-service:8071
# Broker delivery settings (README "Event delivery"); the defaults are the contract's values.
MESSAGE_ACK_TIMEOUT_SECONDS=5
MESSAGE_MAX_ATTEMPTS=3
MESSAGE_RETENTION_HOURS=24
# Grafana's admin password (user admin) at http://localhost:3000. A real value goes in .env only.
GRAFANA_ADMIN_PASSWORD=change_me
# The Gateway's cache nodes (Lab 5, #167, #166): host:port list the consistent hashing ring is built over, passed to
# the Gateway block (its default is this list); the internal container addresses, nothing secret.
CACHE_NODES=cache-1:6379,cache-2:6379,cache-3:6379
# Developer alerts of Service Discovery in the team's Telegram group: the bot's token and the group's chat id.
# Both empty = alerts are only logged. Real values go in .env only, never in a commit.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Database replication (Lab 5, #164; deployments/postgres-ha, deployments/mongo-rs): the passwords of the `replicator`
# and `failover` roles of every PostgreSQL cluster, and the key the MongoDB replica set members authenticate each
# other with (6 to 1024 base64 characters, for example the output of `openssl rand -base64 48`). The init scripts also
# create `etl_reader` with ETL_READER_PASSWORD (below, with the ETL). No single quote in the passwords. Real values go
# in .env only.
REPLICATION_PASSWORD=change_me
FAILOVER_PASSWORD=change_me
MONGO_REPLICA_KEY=Y2hhbmdlLW1lLXRvLWEtcmFuZG9tLWtleQ

# Data warehouse and ETL (Lab 5, #165; README "Data warehouse and ETL"). The three passwords go into connection URLs:
# letters, digits and - _ . ~ only.
# The warehouse's owner `warehouse` (warehouse-postgres, warehouse_db), the user the ETL Service writes as.
WAREHOUSE_PASSWORD=change_me
# grafana_reader, the read-only role of Grafana's "Warehouse" datasource (the "Analytics" dashboard), created by
# deployments/warehouse/init-grafana-reader.sh on an empty warehouse volume.
WAREHOUSE_GRAFANA_PASSWORD=change_me
# etl_reader, the read-only role the ETL reads every service database as (created by #164's init scripts).
ETL_READER_PASSWORD=change_me
# Seconds between two scheduled runs of the ETL (the first one right after it starts).
ETL_INTERVAL_SECONDS=60


RULES_POSTGRES_USER=rules_user
RULES_POSTGRES_PASSWORD=change_me
RULES_POSTGRES_DB=rules_db
RULES_ENABLE_DEV_ENDPOINTS=true

UNIVERSITY_RECORD_POSTGRES_USER=university_record_user
UNIVERSITY_RECORD_POSTGRES_PASSWORD=change_me
UNIVERSITY_RECORD_POSTGRES_DB=university_record_db
UNIVERSITY_RECORD_ENABLE_DEV_ENDPOINTS=true

MODERATION_POSTGRES_USER=moderation_user
MODERATION_POSTGRES_PASSWORD=change_me
MODERATION_POSTGRES_DB=moderation_db
MODERATION_DEV_ENDPOINTS=true

DMS_MONGO_USER=dms_user
DMS_MONGO_PASSWORD=change_me
DMS_DEV_ENDPOINTS=true
# The address clients reach Discord DMs' port 8086 at: the base of the ws_url a chat ticket comes with.
DMS_WS_PUBLIC_URL=ws://localhost:8086

PLAYER_POSTGRES_USER=player_user
PLAYER_POSTGRES_PASSWORD=change_me
PLAYER_POSTGRES_DB=player_db
PLAYER_SEED_ON_START=true
PLAYER_ENABLE_DEV_ENDPOINTS=true

SESSION_POSTGRES_USER=session_user
SESSION_POSTGRES_PASSWORD=change_me
SESSION_POSTGRES_DB=session_db
SESSION_SEED_ON_START=true
SESSION_ENABLE_DEV_ENDPOINTS=true

APPLICANT_POSTGRES_USER=applicant_user
APPLICANT_POSTGRES_PASSWORD=change_me
APPLICANT_POSTGRES_DB=applicant_db
APPLICANT_DEV_ENDPOINTS=true

CREDENTIAL_MONGO_USER=credential_user
CREDENTIAL_MONGO_PASSWORD=change_me
CREDENTIAL_DEV_ENDPOINTS=true
