# Copy to .env before running `docker compose up`. Never commit the real .env.

# The one X-Service-Token shared by every service of the stack.
SERVICE_TOKEN=change_me_too

RULES_POSTGRES_USER=rules_user
RULES_POSTGRES_PASSWORD=change_me
RULES_POSTGRES_DB=rules_db

UNIVERSITY_RECORD_POSTGRES_USER=university_record_user
UNIVERSITY_RECORD_POSTGRES_PASSWORD=change_me
UNIVERSITY_RECORD_POSTGRES_DB=university_record_db
UNIVERSITY_RECORD_ENABLE_DEV_ENDPOINTS=true

MODERATION_POSTGRES_USER=moderation_user
MODERATION_POSTGRES_PASSWORD=change_me
MODERATION_POSTGRES_DB=moderation_db
MODERATION_DEV_ENDPOINTS=true

DMS_MONGO_USER=dms_user
DMS_MONGO_PASSWORD=change_me
DMS_DEV_ENDPOINTS=true

PLAYER_POSTGRES_USER=player_user
PLAYER_POSTGRES_PASSWORD=change_me
PLAYER_POSTGRES_DB=player_db
PLAYER_SEED_ON_START=true
PLAYER_ENABLE_DEV_ENDPOINTS=true

SESSION_POSTGRES_USER=session_user
SESSION_POSTGRES_PASSWORD=change_me
SESSION_POSTGRES_DB=session_db
SESSION_SEED_ON_START=true
SESSION_ENABLE_DEV_ENDPOINTS=true

APPLICANT_POSTGRES_USER=applicant_user
APPLICANT_POSTGRES_PASSWORD=change_me
APPLICANT_POSTGRES_DB=applicant_db
APPLICANT_DEV_ENDPOINTS=true

CREDENTIAL_MONGO_USER=credential_user
CREDENTIAL_MONGO_PASSWORD=change_me
CREDENTIAL_DEV_ENDPOINTS=true
