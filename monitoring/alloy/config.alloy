// Alloy for the team stack (Lab 4, #113): ships every container's stdout of this compose project to Loki.
// Every component writes one JSON object per line (README "Logging"), so level, service and event become labels.

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=student-id-please"]
  }
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.json.receiver]
}

loki.process "json" {
  // A line that is not JSON (a database container) is passed on without these labels.
  stage.json {
    expressions = { level = "", service = "", event = "" }
  }

  stage.labels {
    values = { level = "", service = "", event = "" }
  }

  forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
