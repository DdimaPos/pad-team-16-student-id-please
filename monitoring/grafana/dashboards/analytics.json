{
  "uid": "student-id-analytics",
  "title": "Analytics",
  "description": "Decisions, moderators, applicants, shifts and chat across the services, read from the data warehouse warehouse_db that the ETL Service loads (Lab 5, #165).",
  "tags": [
    "student-id-please",
    "lab5"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Decisions per day, correct and wrong",
      "description": "fact_decision by the day of decided_at (Moderation decisions); is_correct as Moderation decided it.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "correct"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "wrong"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day', decided_at) AS time,\n  count(*) FILTER (WHERE is_correct) AS \"correct\",\n  count(*) FILTER (WHERE NOT is_correct) AS \"wrong\"\nFROM fact_decision\nWHERE $__timeFilter(decided_at)\nGROUP BY 1\nORDER BY 1"
        }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "Accuracy per moderator",
      "description": "avg(is_correct) of fact_decision by moderator_id; the name is moderator_username (joined from Player at load time), else dim_player.username, else the id.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "accuracy"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 60
                    },
                    {
                      "color": "green",
                      "value": 80
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT coalesce(d.moderator_username, p.username, d.moderator_id::text, 'unknown') AS moderator,\n  100.0 * avg(d.is_correct::int) AS accuracy,\n  count(*) AS decisions,\n  sum(d.penalty) AS penalties\nFROM fact_decision d\nLEFT JOIN dim_player p ON p.player_id = d.moderator_id\nWHERE $__timeFilter(d.decided_at) AND d.is_correct IS NOT NULL\nGROUP BY 1\nORDER BY accuracy DESC, decisions DESC"
        }
      ]
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "Applicants by status and difficulty",
      "description": "dim_applicant: the actual university status (Applicant, else University Record) by the applicant's difficulty (Applicant). In the time range: the applicant's last change in any of the three sources.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1,
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "stacking": "normal",
        "showValue": "auto",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "xTickLabelRotation": 0,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "difficulty",
            "rowField": "status",
            "valueField": "applicants",
            "emptyValue": "zero"
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT coalesce(actual_university_status, record_university_status, 'unknown') AS status,\n  'difficulty ' || coalesce(difficulty::text, '?') AS difficulty,\n  count(*) AS applicants\nFROM dim_applicant\nWHERE coalesce(applicant_updated_at, credential_updated_at, record_created_at, loaded_at)\n  BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY 1, 2\nORDER BY 1, 2"
        }
      ]
    },
    {
      "id": 4,
      "type": "barchart",
      "title": "Messages per session (top 20)",
      "description": "fact_message: message_count summed over the channels of a session (Discord DMs; the text is never read). In the time range: the last message of the channel.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1,
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "stacking": "none",
        "showValue": "auto",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "xTickLabelRotation": 0,
        "xField": "session",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT left(session_id::text, 8) AS session,\n  sum(message_count) AS messages,\n  count(*) AS channels\nFROM fact_message\nWHERE $__timeFilter(last_sent_at)\nGROUP BY session_id\nORDER BY messages DESC\nLIMIT 20"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Average shift score",
      "description": "avg(score) of fact_shift (Player shifts: one row per player and session) for the shifts ended in the time range, falling back to the session's score (Session).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT avg(coalesce(score, session_score)) AS \"average score\"\nFROM fact_shift\nWHERE $__timeFilter(ended_at)"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Shifts ended",
      "description": "Ended shifts in fact_shift (distinct session_id) in the time range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "x": 6,
        "y": 17,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(DISTINCT session_id) AS shifts\nFROM fact_shift\nWHERE $__timeFilter(ended_at)"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Decision accuracy",
      "description": "avg(is_correct) of every decision in fact_decision in the time range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT 100.0 * avg(is_correct::int) AS accuracy\nFROM fact_decision\nWHERE $__timeFilter(decided_at) AND is_correct IS NOT NULL"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Last finished ETL run",
      "description": "ended_at of the newest run in etl_run that loaded (succeeded or partial): how fresh the warehouse is.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "x": 18,
        "y": 17,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT max(ended_at) AS \"last run\"\nFROM etl_run\nWHERE status IN ('succeeded', 'partial')"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Average shift score per day, per difficulty",
      "description": "avg(score) of fact_shift by the day of ended_at and the session's difficulty (Session).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "always",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day', ended_at) AS time,\n  'difficulty ' || coalesce(difficulty::text, '?') AS metric,\n  avg(coalesce(score, session_score)) AS value\nFROM fact_shift\nWHERE $__timeFilter(ended_at)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Last ETL runs",
      "description": "etl_run, newest first (what GET /api/v1/runs lists): trigger, status, duration, the rows inserted or changed per warehouse table, and the sources that failed or were not configured.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "succeeded": {
                        "color": "green",
                        "index": 0
                      },
                      "partial": {
                        "color": "orange",
                        "index": 1
                      },
                      "failed": {
                        "color": "red",
                        "index": 2
                      },
                      "aborted": {
                        "color": "red",
                        "index": 3
                      },
                      "running": {
                        "color": "blue",
                        "index": 4
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "started"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT id AS run,\n  started_at AS started,\n  trigger,\n  status,\n  duration_ms / 1000.0 AS duration,\n  (SELECT coalesce(sum(v::bigint), 0) FROM jsonb_each_text(rows) AS t(k, v)) AS rows,\n  rows::text AS \"rows per table\",\n  (SELECT string_agg(f->>'source', ', ' ORDER BY f->>'source') FROM jsonb_array_elements(failed_sources) AS a(f)) AS \"failed sources\",\n  (SELECT string_agg(s, ', ' ORDER BY s) FROM jsonb_array_elements_text(skipped_sources) AS x(s)) AS \"skipped sources\"\nFROM etl_run\nORDER BY started_at DESC\nLIMIT 20"
        }
      ]
    }
  ]
}
