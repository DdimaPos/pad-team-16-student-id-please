        {
          "name": "Create applicant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/applicants",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "applicants"
              ]
            },
            "description": "Stores an applicant from a profile you supply, for testing a specific case by hand.\n\nIt does not publish applicant.initialized: that event carries both the claimed and the actual profile, and an applicant made this way has no separate truth to send.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"{{session_id}}\",\n  \"name\": \"Ana Rusu\",\n  \"student_id\": \"FAF24214\",\n  \"email\": \"ana.rusu@isa.utm.md\",\n  \"major\": \"FAF\",\n  \"year\": 2,\n  \"university_status\": \"faf_student\",\n  \"courses\": [\n    \"POO\",\n    \"SDA\"\n  ],\n  \"role\": \"student\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('created_applicant_id',",
                  "  pm.response.json().applicant_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Patch applicant",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/applicants/{{created_applicant_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "applicants",
                "{{created_applicant_id}}"
              ]
            },
            "description": "Partially updates the claimed profile. Only the claimed side is editable; the truth is the answer key and is not reachable through the API at all.\n\nAn absent field is left alone and an explicit null clears it, which for student_id, major and year are different instructions.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana-Maria Rusu\",\n  \"year\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('created_applicant_id')) {",
                  "  throw new Error('created_applicant_id is not set \u2014 run the request that creates it first, or use Run Collection.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('the change was applied', () => {",
                  "  pm.expect(body.name).to.eql('Ana-Maria Rusu');",
                  "  pm.expect(body.year).to.eql(3);",
                  "});",
                  "pm.test('untouched fields survive', () => {",
                  "  pm.expect(body.major).to.eql('FAF');",
                  "});"
                ]
              }
            }
          ]
        },
