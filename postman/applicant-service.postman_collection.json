              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('applicant_id')) {",
                  "  throw new Error('applicant_id is not set \u2014 run the request that creates it first, or use Run Collection.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('405 Method Not Allowed', () => pm.response.to.have.status(405));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown route",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/nonsense",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "nonsense"
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('NOT_FOUND', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
