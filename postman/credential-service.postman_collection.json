        {
          "name": "Impossible person",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/applicants",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "applicants"
              ]
            },
            "description": "A liar is fine; somebody who cannot exist is not. An enrolled student with no identifier leaves this service with nothing coherent to print, so 422 means 'impossible person', not 'dishonest person'.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"{{session_id}}\",\n  \"claimed\": {\n    \"name\": \"Ana Rusu\",\n    \"student_id\": null,\n    \"email\": \"ana.rusu@isa.utm.md\",\n    \"major\": \"FAF\",\n    \"year\": 2,\n    \"university_status\": \"faf_student\",\n    \"courses\": [],\n    \"role\": \"student\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"422\", () => pm.response.to.have.status(422));",
                  "const err = pm.response.json().error;",
                  "pm.test(\"names the violated invariant\", () => {",
                  "    pm.expect(err.code).to.eql(\"VALIDATION_ERROR\");",
                  "    pm.expect(err.details).to.have.property(\"invariant\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unsupported method",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Even a 405 is the contract's JSON envelope."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"405\", () => pm.response.to.have.status(405));",
                  "pm.test(\"METHOD_NOT_ALLOWED\", () => pm.expect(pm.response.json().error.code).to.eql(\"METHOD_NOT_ALLOWED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown route",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/nope",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "nope"
              ]
            },
            "description": "Even a 404 on an unknown path is the contract's JSON envelope."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"NOT_FOUND\", () => pm.expect(pm.response.json().error.code).to.eql(\"NOT_FOUND\"));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
