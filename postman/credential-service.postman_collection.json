{
  "info": {
    "name": "Credential Service",
    "description": "Team 16 - Student ID, please. Credential Service owns the documents an applicant presents and each document's validation status.\n\nRun the folders in order: 'Contract endpoints' stores an applicant_id that the later folders reuse. Set base_url to wherever the service is listening (8082 by default).\n\nThe single most important assertion in here is in 'Documents (what players see)': the player-facing endpoint must never return validation_status or problems.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8082"
    },
    {
      "key": "session_id",
      "value": "3a7e9b1c-2d4f-4b6a-8c0e-1f2a3b4c5d6e"
    },
    {
      "key": "applicant_id",
      "value": ""
    },
    {
      "key": "manual_applicant_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Says the process is serving. It deliberately checks no dependency: restarting a healthy container because somebody else's database was slow would be wrong."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"names the service\", () => pm.expect(pm.response.json().service).to.eql(\"credential-service\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health/ready",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health",
                "ready"
              ]
            },
            "description": "Says the service can do useful work. MongoDB is the only hard dependency; a broker that is away leaves it degraded but still 200, because every REST endpoint still works."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 while mongo is up\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"mongo is up\", () => pm.expect(body.components.mongodb.status).to.eql(\"up\"));",
                  "pm.test(\"status is ok or degraded\", () => pm.expect([\"ok\", \"degraded\"]).to.include(body.status));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Contract endpoints",
      "item": [
        {
          "name": "Next applicant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/applicants/next",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "applicants",
                "next"
              ]
            },
            "description": "Creates a new applicant, starting from the documents they bring. Credential stores them, publishes applicant.initialized and returns the new applicant_id.\n\nThe payload and response are identical to Applicant Service's, so Session Service could switch to this endpoint without any change on its side.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"{{session_id}}\",\n  \"difficulty\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"returns the three contract fields\", () => {",
                  "    pm.expect(body).to.have.property(\"applicant_id\");",
                  "    pm.expect(body).to.have.property(\"session_id\");",
                  "    pm.expect(body).to.have.property(\"created_at\");",
                  "});",
                  "pm.test(\"created_at is ISO-8601 in UTC\", () => pm.expect(body.created_at).to.match(/Z$/));",
                  "pm.collectionVariables.set(\"applicant_id\", body.applicant_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Documents (what players see)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/applicants/{{applicant_id}}/documents",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "applicants",
                "{{applicant_id}}",
                "documents"
              ]
            },
            "description": "The documents the applicant shows to the Moderator.\n\nValidation results are NOT included: finding the problems is the players' job, and a leak here would make the whole game trivial."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"documents is always an array\", () => pm.expect(body.documents).to.be.an(\"array\"));",
                  "pm.test(\"NO verdict reaches a player\", () => {",
                  "    pm.expect(pm.response.text()).to.not.include(\"validation_status\");",
                  "    pm.expect(pm.response.text()).to.not.include(\"problems\");",
                  "});",
                  "pm.test(\"every document has an id, a type and its fields\", () => {",
                  "    body.documents.forEach(d => {",
                  "        pm.expect(d).to.have.property(\"document_id\");",
                  "        pm.expect([\"student_id_card\", \"university_email\", \"enrollment_confirmation\", \"course_registration\"]).to.include(d.type);",
                  "        pm.expect(d.fields).to.be.an(\"object\");",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Documents with validation (services only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/applicants/{{applicant_id}}/documents/validation",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "applicants",
                "{{applicant_id}}",
                "documents",
                "validation"
              ]
            },
            "description": "The same documents together with the result of the structure and authenticity check. Consumed by Moderation Service.\n\nIt says whether each document is sound, not whether the applicant should be admitted. Players must never get this."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"every document carries a verdict from the contract's enum\", () => {",
                  "    body.documents.forEach(d => {",
                  "        pm.expect([\"valid\", \"expired\", \"forged\", \"inconsistent\", \"incomplete\"]).to.include(d.validation_status);",
                  "        pm.expect(d.problems).to.be.an(\"array\");",
                  "    });",
                  "});",
                  "pm.test(\"a verdict is always explained\", () => {",
                  "    body.documents.forEach(d => {",
                  "        if (d.validation_status !== \"valid\") pm.expect(d.problems.length, d.type).to.be.above(0);",
                  "        else pm.expect(d.problems.length, d.type).to.eql(0);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
