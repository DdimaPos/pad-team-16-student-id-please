        {
          "name": "Create applicant (a staged liar)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/applicants",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "applicants"
              ]
            },
            "description": "Extension. Supplies an applicant by hand, which is how you stage a specific liar for a demo.\n\nThis is an outsider claiming to be a second-year FAF student, so every paper they present is forged. It publishes nothing: an applicant somebody typed in is not news the other services should act on.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"{{session_id}}\",\n  \"difficulty\": 1,\n  \"claimed\": {\n    \"name\": \"Ion Popescu\",\n    \"student_id\": \"FAF25314\",\n    \"email\": \"ion.popescu@isa.utm.md\",\n    \"major\": \"FAF\",\n    \"year\": 2,\n    \"university_status\": \"faf_student\",\n    \"courses\": [\n      \"POO\",\n      \"SDA\"\n    ],\n    \"role\": \"student\"\n  },\n  \"actual\": {\n    \"name\": \"Ion Popescu\",\n    \"student_id\": null,\n    \"email\": \"ion.popescu42@gmail.com\",\n    \"major\": null,\n    \"year\": null,\n    \"university_status\": \"outsider\",\n    \"courses\": [],\n    \"role\": \"guest\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"manual_applicant_id\", body.applicant_id);",
                  "pm.test(\"origin is manual\", () => pm.expect(body.origin).to.eql(\"manual\"));",
                  "pm.test(\"the full bundle was built from the claim\", () => pm.expect(body.documents.length).to.eql(4));"
                ]
              }
            }
          ]
        },
        {
          "name": "The staged liar's verdicts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/applicants/{{manual_applicant_id}}/documents/validation",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "applicants",
                "{{manual_applicant_id}}",
                "documents",
                "validation"
              ]
            },
            "description": "Every document supports a claim the university's records contradict, so every one of them is forged."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const docs = pm.response.json().documents;",
                  "pm.test(\"an impersonator's whole bundle is forged\", () => {",
                  "    docs.forEach(d => pm.expect(d.validation_status, d.type).to.eql(\"forged\"));",
                  "});",
                  "pm.test(\"the card names the identifier that was never issued\", () => {",
                  "    const card = docs.find(d => d.type === \"student_id_card\");",
                  "    pm.expect(card.problems.join(\" \")).to.include(\"FAF25314\");",
                  "});"
                ]
              }
            }
          ]
        },
