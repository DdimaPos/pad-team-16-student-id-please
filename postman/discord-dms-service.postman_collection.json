            ],
            "url": {
              "raw": "{{base_url}}/api/v1/dev/events/session-started",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "dev",
                "events",
                "session-started"
              ]
            },
            "description": "Same handler a broker consumer will use. Creates the four channels of {{session_id}} with the access mapping.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{$guid}}\",\n  \"event_type\": \"session.started\",\n  \"occurred_at\": \"2026-09-10T18:05:00Z\",\n  \"producer\": \"server-moderation-session-service\",\n  \"version\": 1,\n  \"payload\": {\n    \"session_id\": \"{{session_id}}\",\n    \"moderator_id\": \"8c1f6a2e-5b7d-4e1a-9c3f-2d4b6a8e0f11\",\n    \"ruleset_version\": 7,\n    \"started_at\": \"2026-09-10T18:05:00Z\",\n    \"junior_moderators\": [\n      {\n        \"player_id\": \"b2d4f6a8-1c3e-4a5b-9d7f-0e2c4a6b8d10\",\n        \"record_scopes\": [\n          \"enrollment\",\n          \"courses\"\n        ]\n      },\n      {\n        \"player_id\": \"c3e5a7b9-2d4f-4b6c-8e0a-1f3b5d7f9a21\",\n        \"record_scopes\": [\n          \"email-groups\",\n          \"fcim-logs\"\n        ]\n      }\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A fresh session on every run: replaying session.ended in folder 4 archives the previous one for good.",
                  "const g = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => { const r = Math.random() * 16 | 0; return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16); });",
                  "pm.collectionVariables.set('session_id', g());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 202', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "replay session.started again is idempotent",
