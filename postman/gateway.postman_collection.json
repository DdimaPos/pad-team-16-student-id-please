{
  "info": {
    "name": "Gateway Service",
    "description": "Routing and the Gateway's own errors, against the team stack (`docker compose up -d`) with the Gateway on `base_url`.\n\nCovers what is implemented: the route scheme, health forwarding, the pass-through of a service's answer, request ids and the 404/400/405 answers of the Gateway. 502 (a service is down) and 408 (a service is too slow) need a service to be stopped or slowed, so they are described in docs/GATEWAY.md; 401/403 (authorization) and 429 (concurrent task limit) are added together with those parts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "service_token",
      "value": "change_me_too"
    },
    {
      "key": "session_id",
      "value": "3a7e9b1c-2d4f-4b6a-8c0e-1f2a3b4c5d6e"
    }
  ],
