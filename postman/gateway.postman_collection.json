      "value": "8c1f6a2e-5b7d-4e1a-9c3f-2d4b6a8e0f11"
    },
    {
      "key": "player_token",
      "value": ""
    },
    {
      "key": "expired_token",
      "value": ""
    },
    {
      "key": "foreign_token",
      "value": ""
    },
    {
      "key": "session_id",
      "value": "3a7e9b1c-2d4f-4b6a-8c0e-1f2a3b4c5d6e"
