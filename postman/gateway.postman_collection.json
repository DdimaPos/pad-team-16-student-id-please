    {
      "name": "routing (client and service calls through the Gateway)",
      "item": [
        {
          "name": "server-rules: current ruleset, difficulty 3",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('the ruleset of difficulty 3', () => { pm.expect(b.difficulty).to.eql(3); pm.expect(b.version).to.be.a('number'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/server-rules/rulesets/current?difficulty=3",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "server-rules",
                "rulesets",
                "current"
              ],
              "query": [
                {
                  "key": "difficulty",
                  "value": "3"
                }
              ]
            },
            "header": [],
            "description": "The prefix is removed: forwarded to GET /api/v1/rulesets/current?difficulty=3 of Server Rules."
          }
        },
        {
          "name": "server-rules: the service's own 404 passes through unchanged",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));",
                  "pm.test('error code RULESET_NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('RULESET_NOT_FOUND'));",
                  "pm.test('the service wrote the message, not the Gateway', () => pm.expect(pm.response.json().error.message).to.include('9999'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/server-rules/rulesets/9999",
