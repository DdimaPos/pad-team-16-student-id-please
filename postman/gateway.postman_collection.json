              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('it is the Gateway', () => { pm.expect(b.status).to.eql('ok'); pm.expect(b.service).to.eql('gateway-service'); });"
