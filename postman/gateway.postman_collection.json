    {
      "name": "Limits (needs DEV_ENDPOINTS=true)",
      "description": "Task timeout and concurrent task limit, demonstrated with Applicant Service's GET /api/v1/dev/slow through the Gateway. `/dev/*` is forwarded with the service token only, so every request here carries `service_token`.",
      "item": [
        {
          "name": "Task timeout (408)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Service-Token",
                "value": "{{service_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/applicant/dev/slow?ms={{slow_ms}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "applicant",
                "dev",
                "slow"
              ],
              "query": [
                {
                  "key": "ms",
                  "value": "{{slow_ms}}"
                }
              ]
            },
            "description": "Asks Applicant Service, through the Gateway, to do nothing for `slow_ms` (6000 ms). With the defaults the service stops the task at its own 5s and the Gateway passes that 408 through unchanged; the Gateway's own 408 (details.service) appears when it runs with a timeout below the service's, e.g. HTTP_REQUEST_TIMEOUT=2. Needs DEV_ENDPOINTS=true in Applicant Service and the service token, which /dev routes require."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The dev endpoint answers 404 when the service runs without DEV_ENDPOINTS=true.",
                  "const devOff = pm.response.code === 404;",
                  "const check = devOff ? pm.test.skip : pm.test;",
                  "check('408 Request Timeout', () => pm.response.to.have.status(408));",
                  "check('code is REQUEST_TIMEOUT, in the shared envelope', () => {",
                  "  const error = pm.response.json().error;",
                  "  pm.expect(error.code).to.eql('REQUEST_TIMEOUT');",
                  "  pm.expect(error.details).to.be.an('object');",
                  "});",
                  "check('stopped at the timeout, not after slow_ms', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(Number(pm.variables.get('slow_ms')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Concurrent task limit (429)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "The pre-request script opens `max_concurrent_tasks` (64) slow requests through the Gateway at once. While they are in progress one more proxied request must be refused with 429 TOO_MANY_REQUESTS and Retry-After, and the Gateway's own GET /health must still answer. Needs DEV_ENDPOINTS=true in Applicant Service, the service token (/dev routes require it) and `max_concurrent_tasks` equal to the Gateway's MAX_CONCURRENT_TASKS."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const base = pm.variables.get('base_url');",
                  "const limit = Number(pm.variables.get('max_concurrent_tasks'));",
                  "const service = { 'X-Service-Token': pm.variables.get('service_token') };",
                  "const seen = {};",
                  "const save = () => pm.variables.set('limit_seen', JSON.stringify(seen));",
                  "save();",
                  "",
                  "pm.sendRequest({ url: base + '/api/v1/applicant/dev/slow?ms=0', method: 'GET', header: service }, (err, res) => {",
                  "  seen.dev = err ? 0 : res.code;",
                  "  save();",
                  "  if (seen.dev !== 200) { return; }",
                  "",
                  "  // Fill every slot. These are still running when the two requests below are sent.",
                  "  for (let i = 0; i < limit; i++) {",
                  "    pm.sendRequest({ url: base + '/api/v1/applicant/dev/slow?ms=3000', method: 'GET', header: service }, () => {});",
                  "  }",
                  "  setTimeout(() => {",
                  "    pm.sendRequest({ url: base + '/api/v1/applicant/applicants?limit=1', method: 'GET', header: service }, (err, res) => {",
                  "      if (!err) { seen.extra = { status: res.code, retryAfter: res.headers.get('Retry-After'), body: res.text() }; }",
                  "      save();",
                  "    });",
                  "    pm.sendRequest(base + '/health', (err, res) => {",
                  "      if (!err) { seen.ready = res.code; }",
                  "      save();",
                  "    });",
                  "  }, 1000);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const seen = JSON.parse(pm.variables.get('limit_seen') || '{}');",
                  "// The dev endpoint answers 404 when the service runs without DEV_ENDPOINTS=true.",
                  "const check = seen.dev === 200 ? pm.test : pm.test.skip;",
                  "check('the request above the limit is refused with 429', () => {",
                  "  pm.expect(seen.extra.status).to.eql(429);",
                  "});",
                  "check('code is TOO_MANY_REQUESTS, with Retry-After', () => {",
                  "  pm.expect(JSON.parse(seen.extra.body).error.code).to.eql('TOO_MANY_REQUESTS');",
                  "  pm.expect(seen.extra.retryAfter).to.be.a('string').and.not.empty;",
                  "});",
                  "check('/health still answers while the limit is reached', () => {",
                  "  pm.expect(seen.ready).to.eql(200);",
                  "});",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Player tokens, signed the way Player Service signs them: HS256 with JWT_SECRET, `sub` = the",
          "// player's id, `iat` and `exp`. The Gateway verifies the signature, so `jwt_secret` must be the",
          "// JWT_SECRET of the Gateway being called (gateway-service/.env).",
          "function b64url(words) {",
          "  return CryptoJS.enc.Base64.stringify(words)",
          "    .replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
          "}",
          "function mint(claims, secret) {",
          "  const header = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify({ alg: 'HS256', typ: 'JWT' })));",
          "  const payload = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(claims)));",
          "  return header + '.' + payload + '.' + b64url(CryptoJS.HmacSHA256(header + '.' + payload, secret));",
          "}",
          "const now = Math.floor(Date.now() / 1000);",
          "const sub = pm.variables.get('player_id');",
          "const secret = pm.variables.get('jwt_secret');",
          "pm.collectionVariables.set('player_token', mint({ sub: sub, iat: now, exp: now + 3600 }, secret));",
          "pm.collectionVariables.set('expired_token', mint({ sub: sub, iat: now - 7200, exp: now - 3600 }, secret));",
          "pm.collectionVariables.set('foreign_token', mint({ sub: sub, iat: now, exp: now + 3600 }, 'not-the-secret-of-this-gateway-at-all'));"
        ]
      }
    }
  ]
