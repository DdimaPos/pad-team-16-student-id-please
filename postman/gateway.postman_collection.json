  "item": [
    {
      "name": "health",
      "item": [
        {
          "name": "GET /health (liveness)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('names the gateway', () => pm.expect(pm.response.json().service).to.eql('gateway-service'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          }
        }
      ]
    },
    {
      "name": "Routing",
      "description": "`{{base_url}}/api/v1/<prefix>/<rest>` is forwarded to the service behind `<prefix>` as `/api/v1/<rest>`, and `/api/v1/<prefix>/health` as the service's own `/health` (CPR README, Gateway). Method, query, body and the service's answer pass through unchanged; the Gateway only handles the credential (next folder), the limits (last folder) and `X-Request-ID`. Applicant and Credential Service are the examples; the mechanics are the same for every prefix of the route table.",
      "item": [
        {
          "name": "A contract call through its prefix: POST /api/v1/applicant/applicants/next",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Service-Token",
                "value": "{{service_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/applicant/applicants/next",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "applicant",
                "applicants",
                "next"
              ]
            },
            "description": "Forwarded to Applicant Service as `POST /api/v1/applicants/next`. The same path exists in Credential and University Record Service; the prefix is what tells them apart. Service-only route, hence the token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"{{session_id}}\",\n  \"difficulty\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('the service answered: an applicant was created', () => {",
                  "  pm.expect(body.applicant_id).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('applicant_id', body.applicant_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "A service's health: /api/v1/applicant/health -> /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/applicant/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "applicant",
                "health"
              ]
            },
            "description": "Health checks live outside the service's `/api/v1` tree, so this is the one path the Gateway rewrites differently. Public, and exempt from the concurrent task limit."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('answered by Applicant Service, not the Gateway', () => {",
                  "  pm.expect(pm.response.json().service).to.eql('applicant-service');",
                  "});",
                  "pm.test('the Gateway added X-Request-ID', () => {",
                  "  pm.expect(pm.response.headers.has('X-Request-ID')).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "The same path behind another prefix: /api/v1/credential/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/credential/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "credential",
                "health"
              ]
            },
            "description": "Only the prefix differs; the request reaches a different service."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('answered by Credential Service', () => {",
                  "  pm.expect(pm.response.json().service).to.eql('credential-service');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgotten prefix (404 NOT_FOUND)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Service-Token",
                "value": "{{service_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/applicants/{{applicant_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "applicants",
                "{{applicant_id}}"
              ]
            },
            "description": "`/api/v1/applicants/...` is the service's own path; through the Gateway it needs `/api/v1/applicant/` in front. No service is registered as `applicants`, so the Gateway answers itself, before any credential check, and `details.service` names the segment it did not recognise."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('NOT_FOUND, in the shared envelope', () => {",
                  "  const e = pm.response.json().error;",
                  "  pm.expect(e.code).to.eql('NOT_FOUND');",
                  "  pm.expect(e.details).to.be.an('object');",
                  "});",
                  "pm.test('details name the unknown prefix', () => {",
                  "  pm.expect(pm.response.json().error.details.service).to.eql('applicants');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "A path that climbs out of the service (400 VALIDATION_ERROR)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/applicant/%2e%2e/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "applicant",
                "%2e%2e",
                "health"
              ]
            },
            "description": "`..`, plain or percent-encoded, never reaches a service: the Gateway refuses the path itself."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('VALIDATION_ERROR, in the shared envelope', () => {",
                  "  const e = pm.response.json().error;",
                  "  pm.expect(e.code).to.eql('VALIDATION_ERROR');",
                  "  pm.expect(e.details).to.be.an('object');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "The service's own error passes through unchanged",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Service-Token",
                "value": "{{service_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/applicant/applicants/00000000-0000-4000-8000-000000000000",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "applicant",
                "applicants",
                "00000000-0000-4000-8000-000000000000"
              ]
            },
            "description": "A 404 from Applicant Service, not from the Gateway: the code is the service's own (`APPLICANT_NOT_FOUND`), and status, headers and body arrive as the service wrote them. Compare with the Gateway's own 404 two requests up, whose code is `NOT_FOUND`."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('the code is the service\\'s, APPLICANT_NOT_FOUND', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('APPLICANT_NOT_FOUND');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "X-Request-ID is kept when the caller sends one",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{request_id}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/applicant/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "applicant",
                "health"
              ]
            },
            "description": "The Gateway generates `X-Request-ID` only when the caller sent none; a caller's own id is forwarded to the service and returned, so one id follows a request through the logs of every hop."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('request_id', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('the id sent is the id returned', () => {",
                  "  pm.expect(pm.response.headers.get('X-Request-ID')).to.eql(pm.variables.get('request_id'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authorization",
      "description": "Credentials are checked at the Gateway and only there (CPR README, Authentication). A player sends `Authorization: Bearer <jwt>` (HS256 with JWT_SECRET, `sub` = the player's id, `iat`, `exp`); a service sends `X-Service-Token`. The Gateway checks the credential the route accepts, removes `Authorization`, `X-Service-Token` and any `X-Player-Id` of the caller, and sets `X-Player-Id: <sub>` for a player. A refusal uses the shared envelope and reaches no service. The collection's pre-request script mints the player tokens with `jwt_secret`; `service_token` and `jwt_secret` must match the Gateway's SERVICE_TOKEN and JWT_SECRET. The first two requests need the applicant created in the Routing folder.",
      "item": [
        {
          "name": "Player-or-service route as a player (200, forwarded with X-Player-Id)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{player_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/applicant/applicants/{{applicant_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "applicant",
                "applicants",
                "{{applicant_id}}"
              ]
            },
            "description": "`GET /applicants/{id}` on Applicant Service accepts either credential. With a player token the service receives `X-Player-Id: <sub>` and no token."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('applicant_id')) {",
                  "  throw new Error('applicant_id is not set — run the request that creates it first, or use Run Collection.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('the applicant asked for', () => {",
                  "  pm.expect(pm.response.json().applicant_id).to.eql(pm.collectionVariables.get('applicant_id'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Player-or-service route as a service (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Service-Token",
                "value": "{{service_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/applicant/applicants/{{applicant_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "applicant",
                "applicants",
                "{{applicant_id}}"
              ]
            },
            "description": "The same route with the service token, as Moderation Service calls it. The service receives no `X-Player-Id` at all."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('applicant_id')) {",
                  "  throw new Error('applicant_id is not set — run the request that creates it first, or use Run Collection.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Player route without a credential (401 UNAUTHENTICATED)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/credential/applicants/00000000-0000-4000-8000-000000000000/documents",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "credential",
                "applicants",
                "00000000-0000-4000-8000-000000000000",
                "documents"
              ]
            },
            "description": "`GET /applicants/{id}/documents` is player only. No token: refused before the service is called, so the applicant id does not even have to exist."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('UNAUTHENTICATED, in the shared envelope', () => {",
                  "  const e = pm.response.json().error;",
                  "  pm.expect(e.code).to.eql('UNAUTHENTICATED');",
                  "  pm.expect(e.details).to.be.an('object');",
                  "});"
                ]
