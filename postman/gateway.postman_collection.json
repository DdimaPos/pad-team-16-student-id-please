{
  "info": {
    "name": "Gateway Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "slow_ms",
      "value": "6000"
    },
    {
      "key": "max_concurrent_tasks",
      "value": "64"
    }
  ],
  "item": [
    {
      "name": "health",
      "item": [
        {
          "name": "GET /health (liveness)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          }
        }
      ]
    },
    {
      "name": "Limits (needs DEV_ENDPOINTS=true)",
      "description": "Task timeout and concurrent task limit, demonstrated with GET /api/v1/dev/slow.",
      "item": [
        {
          "name": "Task timeout (408)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/applicant/dev/slow?ms={{slow_ms}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "applicant",
                "dev",
                "slow"
              ],
              "query": [
                {
                  "key": "ms",
                  "value": "{{slow_ms}}"
                }
              ]
            },
            "description": "Asks Applicant Service, through the Gateway, to do nothing for `slow_ms` (6000 ms). With the defaults the service stops the task at its own 5s and the Gateway passes that 408 through unchanged; the Gateway's own 408 (details.service) appears when it runs with a timeout below the service's, e.g. HTTP_REQUEST_TIMEOUT=2. Needs DEV_ENDPOINTS=true in Applicant Service."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The dev endpoint answers 404 when the service runs without DEV_ENDPOINTS=true.",
                  "const devOff = pm.response.code === 404;",
                  "const check = devOff ? pm.test.skip : pm.test;",
                  "check('408 Request Timeout', () => pm.response.to.have.status(408));",
                  "check('code is REQUEST_TIMEOUT, in the shared envelope', () => {",
                  "  const error = pm.response.json().error;",
                  "  pm.expect(error.code).to.eql('REQUEST_TIMEOUT');",
                  "  pm.expect(error.details).to.be.an('object');",
                  "});",
                  "check('stopped at the timeout, not after slow_ms', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(Number(pm.variables.get('slow_ms')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Concurrent task limit (429)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "The pre-request script opens `max_concurrent_tasks` (64) slow requests through the Gateway at once. While they are in progress one more proxied request must be refused with 429 TOO_MANY_REQUESTS and Retry-After, and the Gateway's own GET /health must still answer. Needs DEV_ENDPOINTS=true in Applicant Service and `max_concurrent_tasks` equal to the Gateway's MAX_CONCURRENT_TASKS."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const base = pm.variables.get('base_url');",
                  "const limit = Number(pm.variables.get('max_concurrent_tasks'));",
                  "const seen = {};",
                  "const save = () => pm.variables.set('limit_seen', JSON.stringify(seen));",
                  "save();",
                  "",
                  "pm.sendRequest(base + '/api/v1/applicant/dev/slow?ms=0', (err, res) => {",
                  "  seen.dev = err ? 0 : res.code;",
                  "  save();",
                  "  if (seen.dev !== 200) { return; }",
                  "",
                  "  // Fill every slot. These are still running when the two requests below are sent.",
                  "  for (let i = 0; i < limit; i++) {",
                  "    pm.sendRequest(base + '/api/v1/applicant/dev/slow?ms=3000', () => {});",
                  "  }",
                  "  setTimeout(() => {",
                  "    pm.sendRequest(base + '/api/v1/applicant/applicants?limit=1', (err, res) => {",
                  "      if (!err) { seen.extra = { status: res.code, retryAfter: res.headers.get('Retry-After'), body: res.text() }; }",
                  "      save();",
                  "    });",
                  "    pm.sendRequest(base + '/health', (err, res) => {",
                  "      if (!err) { seen.ready = res.code; }",
                  "      save();",
                  "    });",
                  "  }, 1000);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const seen = JSON.parse(pm.variables.get('limit_seen') || '{}');",
                  "// The dev endpoint answers 404 when the service runs without DEV_ENDPOINTS=true.",
                  "const check = seen.dev === 200 ? pm.test : pm.test.skip;",
                  "check('the request above the limit is refused with 429', () => {",
                  "  pm.expect(seen.extra.status).to.eql(429);",
                  "});",
                  "check('code is TOO_MANY_REQUESTS, with Retry-After', () => {",
                  "  pm.expect(JSON.parse(seen.extra.body).error.code).to.eql('TOO_MANY_REQUESTS');",
                  "  pm.expect(seen.extra.retryAfter).to.be.a('string').and.not.empty;",
                  "});",
                  "check('/health still answers while the limit is reached', () => {",
                  "  pm.expect(seen.ready).to.eql(200);",
                  "});",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
