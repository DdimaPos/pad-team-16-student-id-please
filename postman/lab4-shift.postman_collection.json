      "value": "http://localhost:8070"
    },
    {
      "key": "prometheus_url",
      "value": "http://localhost:9090"
    },
    {
      "key": "grafana_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "service_token",
      "value": "change_me_too"
    },
    {
      "key": "grafana_password",
      "value": "change_me"
    },
    {
      "key": "password",
      "value": "seed-password"
    },
    {
      "key": "moderator_username",
      "value": "repeat_offender"
    },
    {
      "key": "moderator_id",
      "value": "f6b8c0d4-5a7e-4f9c-b123-4d6e8f0a2b54"
    },
    {
      "key": "junior_username",
      "value": "rookie_one"
    },
    {
      "key": "junior_id",
      "value": "d4f6a8c1-3e5b-4d7c-9f1a-2b4c6d8e0f32"
    },
    {
      "key": "moderator_token",
      "value": ""
    },
    {
      "key": "junior_token",
      "value": ""
