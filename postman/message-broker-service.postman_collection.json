    {
      "name": "dead letters (#108)",
      "description": "GET /api/v1/dead-letters?limit=&offset=: newest first, { items, total }, limit 1 to 100 (default 20), offset from 0.",
      "item": [
        {
          "name": "GET /api/v1/dead-letters",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('a page', () => {",
                  "  pm.expect(b).to.have.all.keys('items','total');",
                  "  pm.expect(b.items).to.be.an('array');",
                  "  pm.expect(b.total).to.be.a('number');",
                  "});",
                  "pm.test('at most the default limit of 20', () => pm.expect(b.items.length).to.be.at.most(20));",
                  "pm.test('newest first', () => { for (let i = 1; i < b.items.length; i++) pm.expect(b.items[i].dead_at <= b.items[i - 1].dead_at).to.be.true; });",
                  "b.items.forEach(d => {",
                  "  pm.test(`${d.message_id} has its shape`, () => {",
                  "    pm.expect(d).to.have.all.keys('message_id','queue','attempts','reason','created_at','dead_at','delivery');",
                  "    pm.expect(d.delivery.event).to.include.keys('event_id','event_type','producer','version');",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Service-Token", "value": "{{service_token}}" }],
            "url": "{{base_url}}/api/v1/dead-letters"
