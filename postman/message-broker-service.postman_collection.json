    {
      "name": "logs (#112)",
      "description": "GET /logs, this instance's lines, as in CPR README \"Logs download\".",
      "item": [
        {
          "name": "GET /logs - its own lines",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('ndjson', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/x-ndjson'));",
                  "pm.test('an attachment', () => pm.expect(pm.response.headers.get('Content-Disposition')).to.match(/^attachment; filename=\".+\\.jsonl\"$/));",
                  "const rows = pm.response.text().split('\\n').filter(Boolean).map(JSON.parse);",
                  "pm.test('one JSON object per line, oldest first', () => { for (let i = 1; i < rows.length; i++) pm.expect(rows[i].time >= rows[i - 1].time).to.be.true; });",
                  "pm.test('the broker\\'s lines', () => rows.forEach(r => pm.expect(r.service).to.eql('message-broker')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Service-Token", "value": "{{service_token}}" }],
            "url": "{{base_url}}/logs?since=2020-01-01T00:00:00Z"
          }
        },
