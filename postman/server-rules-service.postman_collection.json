            "const text = pm.response.text();",
            "['http_requests_total', 'http_request_duration_seconds', 'tasks_in_flight'].forEach(function (series) {",
            "  pm.test(series, function () { pm.expect(text).to.include(series); });",
            "});"
          ] } }]
        }
