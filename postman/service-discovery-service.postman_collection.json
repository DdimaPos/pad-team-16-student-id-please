    {
      "name": "lab 4 (#111)",
      "description": "Service Discovery 4.0.0: topics in the registration, ?topic=, GET /api/v1/topics, the Prometheus targets, GET /metrics, POST /api/v1/alerts and no /openapi.json. Run in order: it registers {{topics_instance_id}} with topics and deregisters it at the end. The dead_letter request raises a real alert, posted to Telegram when the bot is configured. docs/SERVICE_DISCOVERY.md section 5.",
      "item": [
        {
          "name": "PUT /api/v1/instances/{id} with topics (register)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('topics stored', () => pm.expect(b.topics).to.eql({publishes: ['events.session.started'], subscribes: ['events.decision.recorded']}));",
                  "pm.test('load and last_checked_at on the record', () => pm.expect(b).to.include.all.keys('load', 'last_checked_at'));",
                  "pm.test('up', () => pm.expect(b.status).to.eql('up'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Service-Token",
                "value": "{{service_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/instances/{{topics_instance_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_name\": \"session\",\n  \"port\": 8080,\n  \"version\": \"4.0.0\",\n  \"topics\": {\n    \"publishes\": [\n      \"events.session.started\"\n    ],\n    \"subscribes\": [\n      \"events.decision.recorded\"\n    ]\n  }\n}"
            }
          }
        },
