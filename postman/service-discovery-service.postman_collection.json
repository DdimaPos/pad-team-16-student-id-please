            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Service-Token",
                "value": "{{service_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/instances/{{topics_instance_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_name\": \"session\",\n  \"port\": 8080,\n  \"version\": \"4.0.0\"\n}"
