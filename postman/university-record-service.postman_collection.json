              "raw": "{ \"session_id\": \"{{$guid}}\", \"difficulty\": 9 }"
            }
          }
        }
      ]
    },
    {
      "name": "auth edge cases",
      "description": "The three requests on GET /records/{category} go through the Gateway: without X-Player-Id the collection signs no JWT and the Gateway answers 401 UNAUTHENTICATED; with 'not-a-uuid' the JWT's sub is not a player id and the Gateway answers 401 UNAUTHENTICATED; an unknown category passes the Gateway (the route matches any category) and the service answers 422. The service-only-route case goes to the instance directly with X-Player-Id as it is, since the Gateway's 4.0.0 answers 404 on /admin/* before any credential: the service answers 403 SERVICE_TOKEN_REQUIRED to a player on a service-only route.",
      "item": [
        {
          "name": "no X-Player-Id on the player route (401 UNAUTHENTICATED)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/records/enrollment?session_id={{session_id}}&q=x",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "records",
                "enrollment"
              ],
              "query": [
                {
                  "key": "session_id",
                  "value": "{{session_id}}"
                },
                {
                  "key": "q",
                  "value": "x"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('UNAUTHENTICATED', () => pm.expect(pm.response.json().error.code).to.eql('UNAUTHENTICATED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "player id that is not a UUID (401 UNAUTHENTICATED)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/records/enrollment?session_id={{session_id}}&q=x",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "records",
                "enrollment"
              ],
              "query": [
                {
                  "key": "session_id",
                  "value": "{{session_id}}"
                },
                {
                  "key": "q",
                  "value": "x"
                }
              ]
            },
            "header": [
              {
                "key": "X-Player-Id",
                "value": "not-a-uuid"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('UNAUTHENTICATED', () => pm.expect(pm.response.json().error.code).to.eql('UNAUTHENTICATED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "player id on a service-only route (403 SERVICE_TOKEN_REQUIRED - called directly)",
          "request": {
            "method": "GET",
            "url": "{{university_record_direct_url}}/api/v1/admin/courses",
            "header": [
              {
                "key": "X-Player-Id",
                "value": "{{player_a_id}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));",
                  "pm.test('SERVICE_TOKEN_REQUIRED', () => pm.expect(pm.response.json().error.code).to.eql('SERVICE_TOKEN_REQUIRED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "unknown category (422 UNKNOWN_CATEGORY)",
          "request": {
            "method": "GET",
