    {
      "name": "auth edge cases",
      "item": [
        {
          "name": "no X-Player-Id on the player route (401 UNAUTHENTICATED)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/records/enrollment?session_id={{session_id}}&q=x",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "records",
                "enrollment"
              ],
              "query": [
                {
                  "key": "session_id",
                  "value": "{{session_id}}"
                },
                {
                  "key": "q",
                  "value": "x"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('UNAUTHENTICATED', () => pm.expect(pm.response.json().error.code).to.eql('UNAUTHENTICATED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "player id that is not a UUID (401 UNAUTHENTICATED)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/records/enrollment?session_id={{session_id}}&q=x",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "records",
                "enrollment"
              ],
              "query": [
                {
                  "key": "session_id",
                  "value": "{{session_id}}"
                },
                {
                  "key": "q",
                  "value": "x"
                }
              ]
            },
            "header": [
              {
                "key": "X-Player-Id",
                "value": "not-a-uuid"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('UNAUTHENTICATED', () => pm.expect(pm.response.json().error.code).to.eql('UNAUTHENTICATED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "player id on a service-only route (403 SERVICE_TOKEN_REQUIRED)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/courses",
            "header": [
              {
                "key": "X-Player-Id",
                "value": "{{player_a_id}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));",
                  "pm.test('SERVICE_TOKEN_REQUIRED', () => pm.expect(pm.response.json().error.code).to.eql('SERVICE_TOKEN_REQUIRED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "unknown category (422 UNKNOWN_CATEGORY)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/records/not-a-category?session_id={{session_id}}&q=x",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "records",
                "not-a-category"
              ],
              "query": [
                {
                  "key": "session_id",
                  "value": "{{session_id}}"
                },
                {
                  "key": "q",
                  "value": "x"
                }
              ]
            },
            "header": [
              {
                "key": "X-Player-Id",
                "value": "{{player_a_id}}"
              }
            ]
          }
        }
      ]
    },
